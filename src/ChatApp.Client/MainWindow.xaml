<Window x:Class="ChatApp.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ChatApp.Client.ViewModels"
        xmlns:models="clr-namespace:ChatApp.Client.Models"
        mc:Ignorable="d"
        Title="gRPC Chat Demo"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBgBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <!-- ══ LOGIN PANEL (shown when not logged in) ════════════════════ -->
        <Border Visibility="{Binding IsLoggedIn,
                    Converter={x:Static local:BoolToVisibilityConverter.InverseInstance}}"
                Background="White"
                CornerRadius="12"
                Padding="40"
                MaxWidth="440" MaxHeight="500"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.12" BlurRadius="24" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel>
                <!-- Logo/Title -->
                <TextBlock Text="⚡ gRPC Chat"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="Peer-to-peer messaging powered by gRPC"
                           FontSize="13" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- Username -->
                <TextBlock Text="Username" FontSize="12" Foreground="#374151"
                           Margin="0,0,0,4" FontWeight="SemiBold"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding LoginUserName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14"/>

                <!-- Display Name -->
                <TextBlock Text="Display Name (optional)" FontSize="12" Foreground="#374151"
                           Margin="0,0,0,4" FontWeight="SemiBold"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding LoginDisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14"/>

                <!-- API URL -->
                <TextBlock Text="API URL" FontSize="12" Foreground="#374151"
                           Margin="0,0,0,4" FontWeight="SemiBold"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,24"/>

                <!-- Login Button -->
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        Content="Connect"
                        Height="44" FontSize="15"
                        IsEnabled="{Binding IsBusy, Converter={x:Static local:BoolToVisibilityConverter.NegInstance}}"/>

                <TextBlock Text="{Binding StatusText}"
                           FontSize="12" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,12,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ══ MAIN CHAT LAYOUT (shown when logged in) ═══════════════════ -->
        <Grid Visibility="{Binding IsLoggedIn,
                    Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ──────────────────────────────────────────────── -->
            <Grid Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- User info header -->
                <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="⚡ gRPC Chat" FontSize="16" FontWeight="Bold"
                                   Foreground="White" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Fill="#22C55E" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding CurrentDisplayName}"
                                       FontSize="13" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="10"
                                   Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Section: Add peer manually -->
                <Expander Grid.Row="1" Header="Add Peer Manually"
                          Foreground="#94A3B8" Margin="8,8,8,0"
                          Background="Transparent">
                    <StackPanel Margin="4,8,4,4">
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding PeerIpInput, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#2D2D3F" Foreground="White"
                                 BorderBrush="#3D3D5C"
                                 Margin="0,0,0,6">
                            <TextBox.Resources>
                                <Style TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="#2D2D3F"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding PeerPortInput, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#2D2D3F" Foreground="White"
                                 BorderBrush="#3D3D5C"
                                 Margin="0,0,0,6"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddPeerManuallyCommand}"
                                Content="Connect to Peer" Padding="8,6"/>
                    </StackPanel>
                </Expander>

                <!-- Online users list -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,10,16,6">
                        <Grid>
                            <TextBlock Text="CONTACTS" FontSize="11" FontWeight="Bold"
                                       Foreground="#64748B" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Right"
                                    Command="{Binding RefreshUsersManuallyCommand}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#64748B" Cursor="Hand"
                                    Content="↻" FontSize="16" Padding="4,0"
                                    ToolTip="Refresh online users"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding OnlineUsers}"
                             SelectedItem="{Binding SelectedPeer}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"          Value="12,10"/>
                                <Setter Property="Background"       Value="Transparent"/>
                                <Setter Property="BorderThickness"  Value="0"/>
                                <Setter Property="Cursor"           Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2D2D3F"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PeerUser}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar circle -->
                                    <Border Grid.Column="0"
                                            Width="38" Height="38"
                                            CornerRadius="19"
                                            Background="{StaticResource AccentBrush}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DisplayName[0]}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name + status -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusIcon}"
                                                       FontSize="10" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Endpoint}"
                                                       FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Unread badge -->
                                    <Border Grid.Column="2"
                                            Background="#EF4444"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding UnreadCount,
                                                Converter={x:Static local:ZeroToCollapsedConverter.Instance}}">
                                        <TextBlock Text="{Binding UnreadCount}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Local port info -->
                <Border Grid.Row="3" Padding="14,8" Background="#1A1A2E">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="gRPC Port: " FontSize="11" Foreground="#64748B"/>
                        <TextBlock Text="{Binding LocalGrpcPort}"
                                   FontSize="11" Foreground="#94A3B8" FontWeight="SemiBold"/>
                    </StackPanel>
                </Border>

                <!-- Logout -->
                <Button Grid.Row="4"
                        Command="{Binding LogoutCommand}"
                        Content="Disconnect"
                        Margin="12,8" Height="34"
                        Background="#374151" Foreground="White"
                        BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="8,6">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4B5563"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ── CHAT AREA ─────────────────────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Chat header -->
                <Border Grid.Row="0" Background="White" Padding="20,14"
                        BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Visibility="{Binding HasSelectedPeer,
                                        Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                            <TextBlock Text="{Binding SelectedPeer.DisplayName}"
                                       FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedPeer.StatusIcon}"
                                           FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedPeer.Endpoint}"
                                           FontSize="12" Foreground="#6B7280"/>
                                <TextBlock Text=" · typing…"
                                           FontSize="12" Foreground="{StaticResource AccentBrush}"
                                           FontStyle="Italic"
                                           Visibility="{Binding IsPeerTyping,
                                               Converter={x:Static local:BoolToVisibilityConverter.Instance}}"/>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Visibility="{Binding HasSelectedPeer,
                                       Converter={x:Static local:BoolToVisibilityConverter.InverseInstance}}"
                                   Text="Select a contact to start chatting"
                                   FontSize="15" Foreground="#9CA3AF"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Messages area -->
                <ScrollViewer Grid.Row="1"
                              x:Name="MessagesScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16,12"
                              Background="{StaticResource ContentBgBrush}">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ChatMessage}">
                                <Grid Margin="0,0,0,8">
                                    <!-- Mine = right-aligned blue bubble -->
                                    <Border HorizontalAlignment="Right"
                                            MaxWidth="460"
                                            Visibility="{Binding IsMine,
                                                Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                                        <StackPanel>
                                            <Border Background="{StaticResource ChatBubbleMineBrush}"
                                                    CornerRadius="14,2,14,14"
                                                    Padding="14,10">
                                                <TextBlock Text="{Binding Content}"
                                                           Foreground="White"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock Text="{Binding TimeDisplay}"
                                                       FontSize="10" Foreground="#9CA3AF"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,2,4,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Theirs = left-aligned white bubble -->
                                    <Border HorizontalAlignment="Left"
                                            MaxWidth="460"
                                            Visibility="{Binding IsMine,
                                                Converter={x:Static local:BoolToVisibilityConverter.InverseInstance}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding FromUser}"
                                                       FontSize="10" Foreground="#6B7280"
                                                       Margin="4,0,0,2" FontWeight="SemiBold"/>
                                            <Border Background="White"
                                                    CornerRadius="2,14,14,14"
                                                    Padding="14,10">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" Opacity="0.06"
                                                                      BlurRadius="8" ShadowDepth="1"/>
                                                </Border.Effect>
                                                <TextBlock Text="{Binding Content}"
                                                           Foreground="#111827"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock Text="{Binding TimeDisplay}"
                                                       FontSize="10" Foreground="#9CA3AF"
                                                       Margin="4,2,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Typing indicator -->
                <Border Grid.Row="2" Padding="20,4"
                        Visibility="{Binding IsPeerTyping,
                            Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                    <TextBlock FontSize="12" FontStyle="Italic"
                               Foreground="{StaticResource AccentBrush}">
                        <Run Text="{Binding SelectedPeer.DisplayName, Mode=OneWay}"/>
                        <Run Text=" is typing…"/>
                    </TextBlock>
                </Border>

                <!-- Message input bar -->
                <Border Grid.Row="3" Background="White"
                        BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding HasSelectedPeer}"
                                 AcceptsReturn="False"
                                 Margin="0,0,10,0"
                                 local:TextBoxHelper.EnterCommand="{Binding SendMessageCommand}">
                        </TextBox>

                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SendMessageCommand}"
                                IsEnabled="{Binding HasSelectedPeer}"
                                Content="Send ➤"
                                Width="90" Height="38"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
