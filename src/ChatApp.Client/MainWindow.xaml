<Window x:Class="ChatApp.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ChatApp.Client.ViewModels"
        xmlns:models="clr-namespace:ChatApp.Client.Models"
        xmlns:conv="clr-namespace:ChatApp.Client.Converters"
        mc:Ignorable="d"
        Title="⚡ gRPC Chat Demo"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource ContentBgBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:ZeroToCollapsedConverter  x:Key="ZeroToCollapsed"/>
    </Window.Resources>

    <Grid>

        <!-- ══ LOGIN PANEL ══════════════════════════════════════════════ -->
        <Border Visibility="{Binding IsLoggedIn,
                    Converter={conv:BoolToVisibilityConverter},
                    ConverterParameter=inverse}"
                Background="White"
                CornerRadius="12"
                Padding="40"
                MaxWidth="460" MaxHeight="560"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.12" BlurRadius="24" ShadowDepth="4"/>
            </Border.Effect>
            <StackPanel>

                <!-- Title -->
                <TextBlock Text="⚡ gRPC Chat"
                           FontSize="28" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"
                           HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="P2P messaging · auto-discovery · no server needed"
                           FontSize="12" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,0,0,28"/>

                <!-- Username -->
                <TextBlock Text="Username" FontSize="12" Foreground="#374151"
                           Margin="0,0,0,4" FontWeight="SemiBold"/>
                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding LoginUserName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14"/>

                <!-- Display Name -->
                <TextBlock Text="Display name (optional)" FontSize="12" Foreground="#374151"
                           Margin="0,0,0,4" FontWeight="SemiBold"/>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding LoginDisplayName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,14"/>

                <!-- API URL (optional) -->
                <TextBlock FontSize="12" Foreground="#374151" Margin="0,0,0,4" FontWeight="SemiBold">
                    REST API URL <Run Foreground="#9CA3AF">(optional — leave blank for pure P2P)</Run>
                </TextBlock>
                <TextBox Style="{StaticResource ModernTextBox}"
                         Text="{Binding ApiUrl, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,0,6"/>
                <TextBlock Text="e.g. http://192.168.1.10:5000  |  Start ChatApp.WebApi on any PC."
                           FontSize="10" Foreground="#9CA3AF" Margin="2,0,0,20"
                           TextWrapping="Wrap"/>

                <!-- Connect button -->
                <Button Style="{StaticResource PrimaryButton}"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={conv:BoolToVisibilityConverter}, ConverterParameter=neg}"
                        Content="Connect"
                        Height="44" FontSize="15"/>

                <!-- Status -->
                <TextBlock Text="{Binding StatusText}"
                           FontSize="12" Foreground="#6B7280"
                           HorizontalAlignment="Center" Margin="0,12,0,0"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- ══ MAIN CHAT LAYOUT ══════════════════════════════════════════ -->
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── SIDEBAR ──────────────────────────────────────────────── -->
            <Grid Grid.Column="0" Background="{StaticResource SidebarBgBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- header -->
                    <RowDefinition Height="Auto"/>  <!-- add peer -->
                    <RowDefinition Height="*"/>     <!-- contacts -->
                    <RowDefinition Height="Auto"/>  <!-- port info -->
                    <RowDefinition Height="Auto"/>  <!-- disconnect -->
                </Grid.RowDefinitions>

                <!-- User header -->
                <Border Grid.Row="0" Background="{StaticResource HeaderBgBrush}" Padding="16,14">
                    <StackPanel>
                        <TextBlock Text="⚡ gRPC Chat" FontSize="16" FontWeight="Bold"
                                   Foreground="White" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="9" Height="9" Fill="#22C55E" Margin="0,0,6,0"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding CurrentDisplayName}"
                                       FontSize="13" Foreground="#E2E8F0" FontWeight="SemiBold"/>
                        </StackPanel>
                        <!-- API badge -->
                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                Visibility="{Binding ApiConnected,
                                    Converter={conv:BoolToVisibilityConverter}}">
                            <Border.Background>
                                <SolidColorBrush Color="#166534"/>
                            </Border.Background>
                            <TextBlock Text="🌐 API connected" FontSize="10" Foreground="#BBF7D0"/>
                        </Border>
                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left"
                                Visibility="{Binding ApiConnected,
                                    Converter={conv:BoolToVisibilityConverter},
                                    ConverterParameter=inverse}">
                            <Border.Background>
                                <SolidColorBrush Color="#2D2D3F"/>
                            </Border.Background>
                            <TextBlock Text="📡 P2P / local mode" FontSize="10" Foreground="#94A3B8"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Add peer manually (for cross-subnet / VPN) -->
                <Expander Grid.Row="1"
                          Header="+ Add peer by IP"
                          Foreground="#94A3B8"
                          BorderThickness="0"
                          Margin="8,6,8,0">
                    <Expander.Template>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton x:Name="ExpanderButton"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                              Content="{TemplateBinding Header}"
                                              Foreground="#94A3B8"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              HorizontalContentAlignment="Left"
                                              Padding="4,6">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter Visibility="{Binding IsExpanded,
                                    RelativeSource={RelativeSource TemplatedParent},
                                    Converter={conv:BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </ControlTemplate>
                    </Expander.Template>
                    <StackPanel Margin="4,4,4,8">
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding PeerIpInput, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#2D2D3F" Foreground="White" BorderBrush="#3D3D5C"
                                 Margin="0,0,0,6">
                            <TextBox.Resources>
                                <VisualBrush x:Key="HintBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
                                    <VisualBrush.Visual>
                                        <TextBlock Text="IP address" Foreground="#64748B" Margin="10,0"/>
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </TextBox.Resources>
                        </TextBox>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding PeerPortInput, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#2D2D3F" Foreground="White" BorderBrush="#3D3D5C"
                                 Margin="0,0,0,6"/>
                        <Button Style="{StaticResource PrimaryButton}"
                                Command="{Binding AddPeerManuallyCommand}"
                                Content="Connect" Padding="8,6" FontSize="12"/>
                    </StackPanel>
                </Expander>

                <!-- Contacts header + refresh -->
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,8,16,4">
                        <Grid>
                            <TextBlock Text="CONTACTS" FontSize="10" FontWeight="Bold"
                                       Foreground="#4B5563" VerticalAlignment="Center"/>
                            <TextBlock HorizontalAlignment="Right"
                                       FontSize="11" Foreground="#4B5563"
                                       VerticalAlignment="Center">
                                <Run Text="Auto-discovery on" Foreground="#22C55E"/>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Contacts list -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding OnlineUsers}"
                             SelectedItem="{Binding SelectedPeer}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding"                    Value="12,10"/>
                                <Setter Property="Background"                 Value="Transparent"/>
                                <Setter Property="BorderThickness"            Value="0"/>
                                <Setter Property="Cursor"                     Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <EventSetter Event="MouseLeftButtonUp"
                                             Handler="ContactItem_Click"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2D2D3F"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#1D4ED8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:PeerUser}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar -->
                                    <Border Grid.Column="0" Width="38" Height="38"
                                            CornerRadius="19"
                                            Background="{StaticResource AccentBrush}"
                                            Margin="0,0,10,0">
                                        <TextBlock Text="{Binding DisplayName[0]}"
                                                   FontSize="15" FontWeight="Bold"
                                                   Foreground="White"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>
                                    </Border>

                                    <!-- Name + endpoint -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="White"/>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding StatusIcon}"
                                                       FontSize="10" Margin="0,0,4,0"/>
                                            <TextBlock Text="{Binding Endpoint}"
                                                       FontSize="10" Foreground="#94A3B8"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Unread badge -->
                                    <Border Grid.Column="2"
                                            Background="#EF4444"
                                            CornerRadius="10"
                                            Padding="6,2"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding UnreadCount,
                                                Converter={conv:ZeroToCollapsedConverter}}">
                                        <TextBlock Text="{Binding UnreadCount}"
                                                   FontSize="11" FontWeight="Bold"
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <!-- Port info -->
                <Border Grid.Row="3" Padding="14,6" Background="#1A1A2E">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="My gRPC port: " FontSize="11" Foreground="#4B5563"/>
                        <TextBlock Text="{Binding LocalGrpcPort}"
                                   FontSize="11" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="  ·  UDP discovery: 45678"
                                   FontSize="11" Foreground="#374151"/>
                    </StackPanel>
                </Border>

                <!-- Disconnect -->
                <Button Grid.Row="4"
                        Command="{Binding LogoutCommand}"
                        Content="Disconnect"
                        Margin="12,6,12,10" Height="32"
                        Foreground="#9CA3AF" FontSize="12"
                        Background="Transparent" BorderThickness="0" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="8,5">
                                <ContentPresenter HorizontalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#374151"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- ── CHAT AREA ─────────────────────────────────────────────── -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- header -->
                    <RowDefinition Height="*"/>     <!-- messages -->
                    <RowDefinition Height="Auto"/>  <!-- typing indicator -->
                    <RowDefinition Height="Auto"/>  <!-- input bar -->
                </Grid.RowDefinitions>

                <!-- Chat header -->
                <Border Grid.Row="0" Background="White" Padding="20,14"
                        BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                    <Grid>
                        <!-- Peer selected -->
                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedPeer}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding SelectedPeer.DisplayName}"
                                       FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding SelectedPeer.StatusIcon}"
                                           FontSize="12" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding SelectedPeer.Endpoint}"
                                           FontSize="12" Foreground="#6B7280"/>
                                <TextBlock FontSize="12" Foreground="{StaticResource AccentBrush}"
                                           FontStyle="Italic" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPeerTyping}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    typing…
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>

                        <!-- No peer selected -->
                        <TextBlock Text="Select a contact to start chatting"
                                   FontSize="15" Foreground="#9CA3AF" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasSelectedPeer}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Messages list -->
                <ScrollViewer Grid.Row="1"
                              x:Name="MessagesScroller"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16,10"
                              Background="{StaticResource ContentBgBrush}">
                    <ItemsControl x:Name="MessagesItemsControl"
                                  ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ChatMessage}">
                                <Grid Margin="0,0,0,8">

                                    <!-- My message — right-aligned blue bubble -->
                                    <Border HorizontalAlignment="Right" MaxWidth="500">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <Border Background="{StaticResource ChatBubbleMineBrush}"
                                                    CornerRadius="14,2,14,14"
                                                    Padding="14,10">
                                                <TextBlock Text="{Binding Content}"
                                                           Foreground="White"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock Text="{Binding TimeDisplay}"
                                                       FontSize="10" Foreground="#9CA3AF"
                                                       HorizontalAlignment="Right"
                                                       Margin="0,3,4,0"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Their message — left-aligned white bubble -->
                                    <Border HorizontalAlignment="Left" MaxWidth="500">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsMine}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <TextBlock Text="{Binding FromUser}"
                                                       FontSize="10" Foreground="#6B7280"
                                                       Margin="4,0,0,2" FontWeight="SemiBold"/>
                                            <Border Background="White"
                                                    CornerRadius="2,14,14,14"
                                                    Padding="14,10">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="#000000" Opacity="0.06"
                                                                      BlurRadius="8" ShadowDepth="1"/>
                                                </Border.Effect>
                                                <TextBlock Text="{Binding Content}"
                                                           Foreground="#111827"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                            </Border>
                                            <TextBlock Text="{Binding TimeDisplay}"
                                                       FontSize="10" Foreground="#9CA3AF"
                                                       Margin="4,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Typing indicator row -->
                <Border Grid.Row="2" Padding="20,4"
                        Background="{StaticResource ContentBgBrush}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPeerTyping}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontSize="12" FontStyle="Italic"
                               Foreground="{StaticResource AccentBrush}">
                        <Run Text="{Binding SelectedPeer.DisplayName, Mode=OneWay}"/>
                        <Run Text=" is typing…"/>
                    </TextBlock>
                </Border>

                <!-- Message input bar -->
                <Border Grid.Row="3" Background="White"
                        BorderBrush="#E5E7EB" BorderThickness="0,1,0,0"
                        Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 x:Name="MessageInputBox"
                                 Style="{StaticResource ModernTextBox}"
                                 Text="{Binding MessageInput, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding HasSelectedPeer}"
                                 KeyDown="MessageInput_KeyDown"
                                 Margin="0,0,10,0"
                                 VerticalContentAlignment="Center"/>

                        <Button Grid.Column="1"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding SendMessageCommand}"
                                IsEnabled="{Binding HasSelectedPeer}"
                                Content="Send ➤"
                                Width="90" Height="38"/>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
